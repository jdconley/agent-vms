#!/bin/bash
set -euo pipefail
RECORDINGS_DIR="${AGENT_VMS_RECORDINGS_DIR:-$HOME/recordings}"
PIDFILE="$RECORDINGS_DIR/.pid"
[ -f "$PIDFILE" ] || { echo 'No recording is running.' >&2; exit 1; }
exec 9>"$RECORDINGS_DIR/.lock"
flock -n 9 || { echo 'Another recording operation is in progress.' >&2; exit 1; }
PID="$(cat "$PIDFILE")"
if ! ps -p "$PID" -o comm= 2>/dev/null | grep -q 'ffmpeg$'; then
  rm -f "$PIDFILE"
  echo 'The recording already exited. Inspect the MP4 and recording log.' >&2
  exit 1
fi
kill -INT "$PID"
for _ in $(seq 1 40); do
  if ! kill -0 "$PID" 2>/dev/null || ps -p "$PID" -o stat= | grep -q '^Z'; then
    rm -f "$PIDFILE"
    echo "Recording stopped. Videos: $RECORDINGS_DIR"
    exit 0
  fi
  sleep 0.25
done
echo 'ffmpeg has not stopped; recording state retained. Retry record-stop.' >&2
exit 1
